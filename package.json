{
  "name": "figma-navi-video",
  "version": "1.0.0",
  "description": "Daily vertical video for YouTube Shorts + Instagram Reels: Jev の毎朝ニュース (genre trial #2, data/content-format.json = jev) or 新作AIツール N選 from the Product Hunt feed (trial #1, format = pickup)",
  "main": "index.js",
  "scripts": {
    "start": "npx remotion studio",
    "audio": "node scripts/generate-audio.mjs",
    "render": "npx remotion render AiToolsTop5 output/aitools.mp4",
    "pipeline": "node scripts/pipeline.mjs",
    "dry-run": "CONTENT_FORMAT=pickup DRY_RUN=1 ENRICHED_PATH=data/samples/enriched-ai-tools.pickup.sample.json PH_SNAPSHOT_PATH=data/samples/product-hunt-daily.pickup.sample.json ALLOW_STALE_DATE=1 node scripts/pipeline.mjs",
    "dry-run:ranking": "CONTENT_FORMAT=pickup DRY_RUN=1 PH_ALLOW_RANKING=1 ENRICHED_PATH=data/samples/enriched-ai-tools.sample.json PH_SNAPSHOT_PATH=data/samples/product-hunt-daily.sample.json ALLOW_STALE_DATE=1 node scripts/pipeline.mjs",
    "dry-run:skip": "CONTENT_FORMAT=pickup DRY_RUN=1 ENRICHED_PATH=data/samples/enriched-ai-tools.skip.sample.json PH_SNAPSHOT_PATH=data/samples/product-hunt-daily.skip.sample.json ALLOW_STALE_DATE=1 node scripts/pipeline.mjs",
    "dry-run:jev-intro": "DRY_RUN=1 JEV_EPISODES_PATH=data/samples/jev-episodes.intro.sample.json ALLOW_STALE_DATE=1 node scripts/pipeline.mjs",
    "dry-run:jev-usecase": "DRY_RUN=1 JEV_EPISODES_PATH=data/samples/jev-episodes.usecase.sample.json ALLOW_STALE_DATE=1 node scripts/pipeline.mjs",
    "fetch-ph": "node scripts/fetch-product-hunt.mjs",
    "validate": "node scripts/validate-enriched.mjs",
    "pdca": "node scripts/pdca-summary.mjs",
    "post-sns": "node scripts/post-sns.mjs",
    "auth:youtube": "node scripts/auth-youtube.mjs",
    "fetch-stats": "node scripts/fetch-stats.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/*.test.mjs\"",
    "validate:jev": "node scripts/jev.mjs validate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@remotion/cli": "^4.0.443",
    "@remotion/renderer": "^4.0.443",
    "cheerio": "^1.2.0",
    "edge-tts-universal": "^1.4.0",
    "google-translate-api-x": "^10.7.2",
    "googleapis": "^171.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.443"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.443",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}

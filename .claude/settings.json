{
  "permissions": {
    "allow": [
      "Bash(gh api --method PUT repos/nannantown/figma-navi-video/pulls/*/merge -f merge_method=squash -f sha=* --jq '{merged,message,sha}')"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh workflow run*)",
      "Bash(gh api *dispatches*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api * -X*)",
      "Bash(gh api --method PUT * --method*)",
      "Bash(gh api *@*)",
      "Bash(gh api *--input*)",
      "Bash(gh api *--hostname*)",
      "Bash(gh api *commit_title*)",
      "Bash(gh api *commit_message*)",
      "Bash(gh api *merge_method=merge*)",
      "Bash(gh api *merge_method=rebase*)",
      "Bash(gh api *merge_method=\"merge*)",
      "Bash(gh api *merge_method=\"rebase*)",
      "Bash(gh api *merge_method='merge*)",
      "Bash(gh api *merge_method='rebase*)",
      "Bash(gh api *sha=\"\"*)",
      "Bash(gh api *sha='' *)",
      "Bash(gh api *sha= *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --delete*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/merge-guard.mjs"
            ],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}

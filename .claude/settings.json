{
  "permissions": {
    "allow": [
      "Bash(gh api --method PUT repos/nannantown/figma-navi-video/pulls/*/merge *)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh workflow run*)",
      "Bash(gh api *dispatches*)",
      "Bash(gh api *DELETE*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --delete*)",
      "Bash(git push *main*)"
    ]
  }
}
